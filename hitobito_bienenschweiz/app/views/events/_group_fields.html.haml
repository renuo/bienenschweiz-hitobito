- entry.used?(:group_ids) do
  - if @groups.present?
    = field_set_tag t('event.run_by') do
      = f.labeled(:group_ids, '&nbsp;'.html_safe) do
        = f.select(:group_ids,
                options_from_collection_for_select(@groups, :id, :to_s, entry.group_ids),
                {},
                { class: "form-select form-select-sm w-100",
                  multiple: true,
                  data: { controller: "tom-select",
                          tom_select_no_results_value: t("global.chosen_no_results") } })
