-# Overrides core to list the teaching staff (Hauptleitung, Leitung, Referenten) below the contact,
-# on the internal event page as well as on the public sign up page.
- if entry.contact
  = section entry.event.class.human_attribute_name(:contact) do
    %dl.dl-horizontal
      = entry.complete_contact_attributes

= render 'events/attrs_teaching_staff'
