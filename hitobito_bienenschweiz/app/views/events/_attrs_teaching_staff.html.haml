- teaching_staff_roles = event_teaching_staff_roles(entry)
- if teaching_staff_roles.present?
  = section t('events.attrs_teaching_staff.title') do
    %dl.dl-horizontal
      - teaching_staff_roles.each do |role|
        = labeled(role.class.label) do
          %strong= role.participation.participant.full_name
          - if role.label.present?
            %p= role.label
          - if role.participation.additional_information.present?
            %p.multiline= role.participation.additional_information
