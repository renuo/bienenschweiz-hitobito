%h1= @event.name

- if @invitation.submitted?
  %p= t(".thank_you")
- elsif @invitation.closed?
  %p= t(".closed")
- else
  = form_with url: feedback_invitation_path(@invitation.token), method: :patch, local: true do |f|
    - @feedback_questions.each do |question|
      - answer = @answers.find { |a| a.feedback_question_id == question.id }
      .form-group.mb-4
        %label.form-label= question.text
        - if answer.errors.any?
          .text-danger= answer.errors.full_messages.to_sentence
        - case question.kind
        - when "rating"
          .rating
            - (1..5).each do |value|
              %label.me-3
                = radio_button_tag "feedback_answers[#{question.id}][rating]", value, answer.rating == value
                = value
        - when "yes_no"
          .yes-no
            %label.me-3
              = radio_button_tag "feedback_answers[#{question.id}][yes_no]", true, answer.yes_no == true
              = t("global.yes")
            %label
              = radio_button_tag "feedback_answers[#{question.id}][yes_no]", false, answer.yes_no == false
              = t("global.no")
        - when "text"
          = text_area_tag "feedback_answers[#{question.id}][text]", answer.text, class: 'form-control'
    = submit_tag t(".submit"), class: 'btn btn-primary'
