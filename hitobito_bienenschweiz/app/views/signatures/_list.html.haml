= crud_table do |t|
  - t.col(Signature.human_attribute_name(:key)) do |sig|
    = t("signatures.keys.#{sig.key}", default: sig.key)
  - t.col(Signature.human_attribute_name(:name)) { |sig| sig.name }
  - t.col(Signature.human_attribute_name(:title)) { |sig| sig.title.to_s }
  - t.col(Signature.human_attribute_name(:image)) do |sig|
    - if sig.image.attached? && sig.image.variable?
      = image_tag(sig.image.variant(resize_to_limit: [100, 40]))
    - elsif sig.image.attached?
      = t("global.yes")
    - else
      = t("global.no")
  - action_col_edit(t)
