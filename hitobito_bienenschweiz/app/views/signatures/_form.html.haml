= entry_form(buttons_bottom: false) do |f|
  = f.labeled(:key) do
    %strong= t("signatures.keys.#{entry.key}", default: entry.key)
  = f.labeled_input_field :name
  = f.labeled_input_field :title
  = f.labeled(:image) do
    = f.file_field :image, accept: "image/png, image/jpeg", class: "form-control form-control-sm"
  - if entry.image.attached? && entry.image.variable?
    .mb-2
      = image_tag(entry.image.variant(resize_to_limit: [200, 80]))
    = f.labeled(:remove_image) do
      = f.boolean_field :remove_image
