= entry_form do |f|
  = f.labeled :group_id do
    = f.collection_select :group_id, @sektionen, :id, :to_s, {}, class: 'form-select form-select-sm'
  = f.labeled :inspector_id do
    = f.collection_select :inspector_id, @inspectors, :id, :to_s, {}, class: 'form-select form-select-sm'
  = f.labeled_input_fields :control_date, :with_voucher
  = f.labeled_i18n_enum_field :control_state, Qcontrol.control_state_labels, class: 'form-select form-select-sm'

