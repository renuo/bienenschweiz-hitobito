- content_for(:head) do
  %style
    :plain
      .feedback-report-question { page-break-inside: avoid; margin-bottom: 2rem; }
      .feedback-report-chart { display: inline-block; margin-right: 24px; vertical-align: top; max-width: 100%; }
      .feedback-report-chart svg { display: block; max-width: 100%; height: auto; }
      .feedback-report-chart--pie { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; }
      .feedback-report-chart__legend { list-style: none; padding: 0; margin: 0; font-size: 0.9em; }
      .feedback-report-chart__legend li { margin-bottom: 2px; }
      .feedback-report-chart__swatch { vertical-align: middle; margin-right: 4px; }
      .feedback-report-chart__value, .feedback-report-chart__axis-label { font-size: 11px; }
      .feedback-report-text-answer { border-left: 3px solid #ccc; padding: 2px 12px; margin-bottom: 12px; }
      .feedback-report-text-answer p:last-child { margin-bottom: 0; }

- if report.courses.empty?
  %p= t(".no_data")
- else
  .feedback-report-summary
    %p
      - if report.courses.one?
        = report.courses.first.to_s
      - else
        = t(".courses_count", count: report.courses.count)
    %p= t(".response_rate", submitted: report.response_count, total: report.invitation_count)

  .row
    - report.questions.reject(&:text?).each do |question|
      .col-md-6.col-lg-4
        .feedback-report-question
          %h4= question.text
          - if question.rating?
            = svg_bar_chart(report.rating_counts(question))
          - elsif question.yes_no?
            = svg_pie_chart(yes_no_pie_segments(report.yes_no_counts(question)))

  - text_questions = report.questions.select(&:text?)
  - if text_questions.any?
    .feedback-report-text-answers
      %h3= t(".text_answers")
      - text_questions.each do |question|
        .feedback-report-question
          %h4= question.text
          - answers = report.text_answers(question)
          - if answers.any?
            - answers.each do |answer|
              .feedback-report-text-answer
                = simple_format(answer)
          - else
            %p= t(".no_text_answers")
