- title entry.to_s

%dl.dl-horizontal
  = labeled(ExternalInvoiceRun.human_attribute_name(:state), entry.state_label)
  = labeled_attr(entry, :started_at)
  = labeled_attr(entry, :finished_at)
  = labeled_attr(entry, :due_count)
  = labeled_attr(entry, :created_count)
  = labeled_attr(entry, :error_count)

%h2.mt-4= t(".errors")
- if run_errors.empty?
  %p= t(".no_errors")
- else
  = table(run_errors, class: "table table-striped table-hover") do |t|
    - t.col(HitobitoLogEntry.human_attribute_name(:created_at)) { |e| l(e.created_at, format: :time) }
    - t.col(Person.model_name.human) do |e|
      - person = external_invoice_run_error_person(e)
      = link_to(person, person_path(person)) if person
    - t.col(MagazineSubscription.model_name.human) do |e|
      - subscription = external_invoice_run_error_subscription(e)
      - if subscription
        = link_to(subscription, external_invoice_run_subscriptions_path(subscription))
    - t.col(ExternalInvoice.human_attribute_name(:period_start)) do |e|
      = l(e.subject.period_start) if e.subject.is_a?(ExternalInvoice) && e.subject.period_start
    - t.col(HitobitoLogEntry.human_attribute_name(:message)) { |e| e.message }
    - t.col(HitobitoLogEntry.human_attribute_name(:payload)) do |e|
      - if e.payload.present?
        %pre.mb-0.small= e.payload.is_a?(String) ? e.payload : JSON.pretty_generate(e.payload)
