= paginate entries

= crud_table do |t|
  - t.col(ExternalInvoiceRun.human_attribute_name(:started_at)) do |run|
    = link_to(l(run.started_at, format: :long), external_invoice_run_path(run))
  - t.col(ExternalInvoiceRun.human_attribute_name(:state)) { |run| run.state_label }
  - t.attrs(:due_count, :created_count, :error_count)

= paginate entries
