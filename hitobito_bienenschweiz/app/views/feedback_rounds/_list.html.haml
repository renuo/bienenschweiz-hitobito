= crud_table do |t|
  - t.sortable_attrs(:kind, :author, :created_at, :closes_at)
  - t.col(t(".responses")) do |round|
    = "#{round.response_count} / #{round.feedback_invitations.count}"
  - t.col("") do |round|
    = link_to t(".show"), group_event_feedback_round_path(@group, @event, round)
  - t.col("") do |round|
    = link_to t(".report"), report_group_event_feedback_round_path(@group, @event, round)
