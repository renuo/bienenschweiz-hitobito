- title entry.to_s

- content_for(:toolbar, render('actions_show'))

%table.table.table-striped
  %thead
    %tr
      %th= Event::Participation.model_name.human
      %th= t(".submitted")
  %tbody
    - entry.feedback_invitations.includes(participation: :participant).each do |invitation|
      %tr
        %td= invitation.person
        %td= invitation.submitted? ? l(invitation.submitted_at, format: :short) : t(".pending")

- if can?(:export, entry)
  = link_to export_group_event_feedback_round_path(@group, @event, entry), class: 'btn btn-primary btn-sm' do
    = icon(:download)
    = t(".export")
