= crud_table(:kind, :supervisor, :supervision_type, :result, :check_date, :author) do |t|
  - t.col(Supervision.human_attribute_name(:document)) do |supervision|
    - if upload_exists?(supervision, :document)
      = link_to(upload_name(supervision, :document), upload_url(supervision, :document), target: :_blank, rel: :noopener)
  - add_table_actions(t)
