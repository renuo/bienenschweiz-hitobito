- if can?(:new, @event.new_role)
  = Dropdown::Event::RoleAdd.new(self, @group, @event)

-# :nocov:
- if can?(:create_invoices_from_list, @group)
  = invoice_button(people: entries.collect(&:person), filter: params, event: @event)
-# :nocov:

= dropdown_people_export(can?(:index_full_participations, @event))

- if @event.course? && can?(:update, @event)
  - if @event.kas_fees_creatable?
    = action_button(t('event/participations.actions_index.create_kas_fees'),
                    create_kas_fees_group_event_participations_path(@group, @event),
                    :coins,
                    method: :post,
                    data: { confirm: t('event/participations.actions_index.create_kas_fees_confirm') })

  - if @event.kas_instructor_fees_creatable?
    = action_button(t('event/participations.actions_index.create_kas_instructor_fees'),
                    new_kas_instructor_fees_group_event_participations_path(@group, @event),
                    :"person-chalkboard")

= action_button(t('global.button.print'), 'javascript:window.print();', :print)

- if can?(:update, @event)
  = action_button(t('event.bulk_answers.edit.button'), edit_group_event_bulk_answers_path(@group, @event), :edit)
