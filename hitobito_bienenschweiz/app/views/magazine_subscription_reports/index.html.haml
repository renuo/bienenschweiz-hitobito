- title t(".title")

%p= t(".explanation")

%p
  = link_to export_magazine_subscription_reports_path, class: "btn btn-primary btn-sm",
    data: {turbo: "false"} do
    = icon(:download)
    = t(".export")

.table-responsive
  %table.table.table-striped
    %thead
      %tr
        %th= t(".subscription_type")
        - @report.months.each do |month|
          %th.text-end= l(month, format: :month_year)
    %tbody
      - @report.categories.each do |category|
        %tr
          %td= t(".categories.#{category}")
          - @report.months.each do |month|
            %td.text-end= @report.amount(month, category)
    %tfoot
      %tr
        %th= t(".total")
        - @report.months.each do |month|
          %th.text-end= @report.total(month)
