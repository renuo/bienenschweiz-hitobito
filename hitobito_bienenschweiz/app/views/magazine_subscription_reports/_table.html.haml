- labels = MagazineSubscription.subscription_type_labels
- paid_labels = @report.paid_types.map { |type| labels.fetch(type.to_sym) }
- highlighted_types = MagazineSubscriptions::Report::WEMF_SPECIAL_TYPES
.table-responsive
  %table.table.table-striped
    %thead
      %tr
        %th{scope: "col"}= t(".month")
        %th.text-end.table-primary.text-black{scope: "col", title: paid_labels.join(", ")}= t(".paid")
        - @report.types.each do |type|
          %th.text-end{scope: "col", class: ("table-info text-black" if highlighted_types.include?(type))}= labels[type.to_sym]
        %th.text-end{scope: "col"}= t(".total")
    %tbody
      - @report.months.each do |month|
        %tr
          %th.text-nowrap{scope: "row"}= l(month, format: :month_year)
          %td.text-end.table-primary.text-black= @report.paid_amount(month)
          - @report.types.each do |type|
            %td.text-end{class: ("table-info text-black" if highlighted_types.include?(type))}= @report.type_amount(month, type)
          %td.text-end.fw-bold= @report.total(month)
