-# rows: label => key, passed to @report.public_send(amount, month, key)
.table-responsive
  %table.table.table-striped
    %thead
      %tr
        %th= t(".subscription_type")
        - @report.months.each do |month|
          %th.text-end= l(month, format: :month_year)
    %tbody
      - rows.each do |label, key|
        %tr
          %td= label
          - @report.months.each do |month|
            %td.text-end= @report.public_send(amount, month, key)
    %tfoot
      %tr
        %th= t(".total")
        - @report.months.each do |month|
          %th.text-end= @report.total(month)
