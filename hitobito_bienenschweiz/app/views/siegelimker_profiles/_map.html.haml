-# Map of the stored coordinates (not the address) to verify them.
- lat, lng = entry.lat, entry.lng
.siegelimker-map{data: {'bienenschweiz--siegelimker-map-target': 'map'}, hidden: !entry.coordinates?}
  %iframe.border.w-100{src: (siegelimker_map_embed_url(lat, lng) if entry.coordinates?),
    title: t('siegelimker_profiles.map.title'), height: 300, loading: 'lazy',
    data: {'bienenschweiz--siegelimker-map-target': 'frame'}}
  = link_to(t('siegelimker_profiles.map.open'), (entry.coordinates? ? siegelimker_map_url(lat, lng) : '#'),
    target: '_blank', rel: 'noopener', data: {'bienenschweiz--siegelimker-map-target': 'link'})
