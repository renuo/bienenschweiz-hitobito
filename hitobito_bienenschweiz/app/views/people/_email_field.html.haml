= f.labeled(:email) do
  %div.d-flex.flex-wrap.align-items-center
    - if can?(:update_email, entry)
      = f.email_field :email, class: 'me-3'
    - else
      %p.inline.mb-0.me-3= entry.email
    = f.label(:show_email_on_website, class: 'checkbox') do
      = f.check_box(:show_email_on_website)
      = Person.human_attribute_name(:show_email_on_website)
  - if can?(:update_email, entry)
    = f.help_inline(t('.used_as_login'))
  - else
    = f.help_block(t('.only_changeable_by_superior'))
