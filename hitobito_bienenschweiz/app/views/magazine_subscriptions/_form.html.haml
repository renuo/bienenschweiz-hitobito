= entry_form do |f|
  %div{data: {controller: 'bienenschweiz--magazine-subscription-form'}}
    = f.labeled_i18n_enum_field :subscription_type, MagazineSubscription.subscription_type_labels, class: 'form-select form-select-sm', data: { 'bienenschweiz--magazine-subscription-form-target': 'type', action: 'change->bienenschweiz--magazine-subscription-form#update' }
    %div{class: ('hidden' unless entry.geschenk_abo?), data: {'bienenschweiz--magazine-subscription-form-target': 'gifter'}}
      = f.labeled_person_field :gifter
  = f.labeled_input_fields :start_date, :end_date, :amount
  = f.labeled_i18n_enum_field :cancellation_reason, MagazineSubscription.cancellation_reason_labels, class: 'form-select form-select-sm'
