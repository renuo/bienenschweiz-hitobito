#!/usr/bin/env ruby
# frozen_string_literal: true

# Test runner for hitobito_bienenschweiz wagon.
#
# When PATH includes ../hitobito/bin (added by wagon activation), `bundle exec rspec`
# would find hitobito/bin/rspec first, which sets WAGONS='' and breaks SimpleCov
# coverage for wagon files. This script takes precedence (PATH_add bin prepends
# hitobito_bienenschweiz/bin before hitobito/bin) and runs rspec correctly.

ENV["RAILS_ENV"] = "test"
ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile.local", __dir__)

require "rubygems"
require "bundler/setup"

load Gem.bin_path("rspec-core", "rspec")
