#!/usr/bin/env bash

set -euo pipefail

git submodule update --init --recursive

# make sure direnv is installed
direnv version || { echo "direnv not found. Please install it first: https://direnv.net/docs/installation.html"; exit 1; }

if [ ! -f .envrc ]; then
    echo "Copying default .envrc file"
    cp .envrc.example .envrc
    direnv allow
fi

pushd hitobito
    if [ ! -L Gemfile.local ]; then
        ln -s Gemfile Gemfile.local
    fi
    bin/wagon activate bienenschweiz
    direnv exec bin/setup
popd


if [ ! -f .git/hooks/pre-push ]; then
    echo -e "\n== Creating pre-push hook link =="
    ln -s ../../bin/fastcheck .git/hooks/pre-push
fi
